{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build LaTeX (XeLaTeX)",
      "type": "shell",
      "command": "mkdir -p build && xelatex -interaction=nonstopmode -synctex=1 -output-directory=build \"${file}\" && cp build/*.pdf .",
      "options": {
        "cwd": "${fileDirname}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Build LaTeX twice (XeLaTeX)",
      "type": "shell",
      "command": "mkdir -p build && xelatex -interaction=nonstopmode -synctex=1 -output-directory=build \"${file}\" && xelatex -interaction=nonstopmode -synctex=1 -output-directory=build \"${file}\" && cp build/*.pdf .",
      "options": {
        "cwd": "${fileDirname}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Clean LaTeX auxiliary files",
      "type": "shell",
      "command": "rm -rf build",
      "options": {
        "cwd": "${fileDirname}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    }
  ]
}
