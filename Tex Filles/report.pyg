% Πλήρες script: ape_ergasia_1.m
clc
clear
close all

% AEM:6930

Tanaf = 100;  %Celsius
Tznx = 45;
Tk =  6.6; %  "θερμοκρασία νερού δικτύου" πίνακας 2.6
Ta = 5.1; % Celsius "Μέση μινιαία θερμοκρασία κατα τη διάρκεια της ημέρας (Κοζάνη πίνακας 3.2 , Δεκέμβρης) "
FR_mult_Ul = 0.7; % πινακας 5.10 (η0)
FR_mult_tan = 1.8; % πινακας 5.10 (α1)
FRdot_div_FR = 0.95;  %FR'/FR
ta_div_tan = 0.99; %τα/ταn
k1 = 1; %έστω Μ = 75 ;
k3 = 1;
Ta_dot = 3.9; % πίνακας 3.1 Μέση Μινιαία θερμοκρασία περιβάλλοντος"
k2 = (11.6 + 1.18*Tznx + 3.86*Tk - 2.32*Ta_dot)/(100-Ta_dot);
p = 1000; %kg/m^3
HKznx = 80*300; % "Μέση ημερήσια κατανάλωση ζεστού νερού" , πίνακας 2.5, αρ. κλινών = 300
Cp = 4180; % J/kg*K

dt = [2678400 2419200 2678400 2592000 2678400 2592000 2592000 2678400 2592000 2592000 2592000 2678400];

N = [31 28 31 30 31 30 31 31 30 31 30 31] ; %αριθμός ημερών κάθε μήνα

Hb = [51 68 106 141 181 203 210 188 141 95 57 44]*3600*10^3 ; %Μέση μινιαία ηλιακή ακτινοβολία, "Σέρρες , σελ.70"

hls = 1 - 12.1/100 ; %"ποσοστό απωλειών κεντρικού δικτύου διανομής", μόνωση κτηρίου αναφοράς, με ανακυκλοφορία, σελ30 οδηγίες

L = (N*HKznx*p*Cp*(Tznx-Tk)/hls)*10^(-3);
     Lsum = sum(L);

% Αρχικοποίηση αναζήτησης
Ac_max = 1e6;

Ac_found = NaN;

% --------------------------------------------------------------------------

% erwtimama 1

for Ac = 0:Ac_max

     X = (Ac./L).*FR_mult_Ul.*FRdot_div_FR.*(Tanaf - Ta).*dt.*k1.*k2;

     Y = (Ac./L).*FR_mult_tan.*FRdot_div_FR.*ta_div_tan.*Hb.*k3;

     f = 1.029*Y - 0.065*X - 0.245.*(Y.^2) + 0.0018.*(X.^2) + 0.0215.*(Y.^3);
     f_sum = sum(f) ;

     % Ασφάλεια: αν f_sum == 0, προχώρησε στο επόμενο Ac (αποφυγή διαίρεσης/NaN)
    if f_sum == 0
        continue
    end

     Li_mult_fi = L.*f ;
     SF =  sum(Li_mult_fi)/sum(L);

     if SF >= 0.6
        Ac_found = Ac;
        break
    end
end

% Εμφάνισε αποτέλεσμα
if ~isnan(Ac_found)
    fprintf('Βρέθηκε Ac = %d με SF = %.4f\n', Ac_found, SF);
else
    fprintf('Δεν βρέθηκε Ac <= %d που να δίνει SF >= 0.6. Τελευταίο SF = %.4f\n', Ac_max, SF);
end

%--------------------------------------------------------------------------------------------

% erwtimama 2

V_dexamenis = 75*Ac ; % "lt"

 Vd = HKznx ;
 Cp1 = 4.18 ;   % kJ/(kg*K)
 Tcw = 6.6 ;   % "θερμοκρασία νερού δικτύου" πίνακας 2.6
 p_den = 1 ;   % kg/lt
 %hls ΘΕΛΕΙ ΑΛΛΑΓΗ !!!

 Qdem_HW = (Vd*(Cp1/3600)*p_den*(45 - Tcw))*(1/hls);
 QHW = Qdem_HW/5 %KWh ??

 %--------------------------------------------------------------------------------------------

 % erwtimama 3

 h_boiler = 0.8 ; % "σελίδα 34 οδηγός εργασίας"
 EF_CO2 = 0.264 ;

 E_fuel = Qdem_HW*365/h_boiler ;
 mCo2 = EF_CO2*E_fuel ;


 h_pump = 0.4 ; % η αντλία θερμότητας καλύπτει το 40 % φορτίου
 COP = 4 ;

 E_el = QHW*365*h_pump/COP ;
 EF_el = 0.989;
 mCo2_new = EF_el*E_el ;

 Dm_Co2 = (mCo2 - mCo2_new)

 %--------------------------------------------------------------------------------------------

 % erwtimama 4

L_dec = N(12)*HKznx*p*Cp*(Tznx-Tk)*10^(-3);

Vtank = L_dec /(p*Cp*(45 - Tcw)) %lt
