{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build LaTeX (XeLaTeX)",
      "type": "shell",
      "command": "xelatex",
      "args": [
        "-interaction=nonstopmode",
        "-synctex=1",
        "${file}"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Build LaTeX twice (XeLaTeX)",
      "type": "shell",
      "command": "xelatex -interaction=nonstopmode -synctex=1 \"${file}\" && xelatex -interaction=nonstopmode -synctex=1 \"${file}\"",
      "options": {
        "cwd": "${fileDirname}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Clean LaTeX auxiliary files",
      "type": "shell",
      "command": "rm -f *.aux *.log *.out *.toc *.lof *.lot *.fls *.fdb_latexmk *.synctex.gz",
      "options": {
        "cwd": "${fileDirname}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    }
  ]
}
